{
  "name": "agent-voice-chat",
  "version": "1.0.0",
  "description": "AI voice chat with two agents (Bob & Alice) - speak to them and they speak back",
  "main": "dist/server.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node dist/server.js",
    "dev": "node --watch server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.js",
    "build:packages": "npm run build --workspace=packages/core && npm run build --workspace=packages/react && npm run build --workspace=packages/vue"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "axios": "^1.20.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "form-data": "^4.0.6",
    "helmet": "^8.1.0",
    "nanoid": "^3.3.18",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.7.5",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
