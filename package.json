  "scripts": {
    "build": "turbo build",
    "build:legacy": "npx tsc && npx vite build",
    "build:server": "npx tsc",
    "build:client": "npx vite build",
    "dev": "npx tsx watch packages/server/src/index.ts",
    "dev:legacy": "npx tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "start:legacy": "node server.js",
    "lint": "npx eslint src/",
    "lint:fix": "npx eslint src/ --fix",
    "typecheck": "npx tsc --noEmit && npx tsc -p tsconfig.client.json --noEmit",
    "test": "cd packages/core && npx --no-install vitest run",
    "test:client": "vitest run -c vitest.config.ts",
    "format": "npx prettier --write \"src/**/*.ts\"",
    "format:check": "npx prettier --check \"src/**/*.ts\"",
    "docker:build": "docker build -t xspace-agent .",
    "docker:run": "docker run --env-file .env -p 3000:3000 --shm-size=2gb xspace-agent",
    "docker:up": "docker compose up -d",
    "docker:up:monitoring": "docker compose --profile with-monitoring up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f agent",
    "security": "npm audit --audit-level=high",
    "security:audit": "npm audit --audit-level=high",
    "db:migrate": "pnpm -F xspace-agent run db:migrate",
    "db:seed": "pnpm -F xspace-agent run db:seed",
    "operator": "node scripts/operator.js",
    "selectors:audit": "node x-spaces/scripts/audit-selectors.js",
    "preflight": "node scripts/preflight.js",
    "prestart:legacy": "node scripts/preflight.js --skip pulse,cdp || true",
    "test:server": "vitest run --config vitest.config.server.mjs",
    "test:voice": "pnpm test:server",
    "test:load": "artillery run tests/load/basic.yml",
    "test:load:rest": "artillery run tests/load/rest-api.yml",
    "test:stress": "artillery run tests/load/stress.yml",
    "test:soak": "artillery run tests/load/soak.yml",
    "test:load:report": "artillery run tests/load/basic.yml --output tests/load/reports/raw.json && node tests/load/reporter.js tests/load/reports/raw.json",
    "vm-bringup": "node scripts/vm-bringup.js",
    "reconnect-agent": "node scripts/reconnect-agent.js",
    "unmute-greet": "node scripts/unmute-and-greet.js",
    "unmute": "node scripts/unmute-only.js",
    "x-join": "node scripts/x-join-only.js"
  },
